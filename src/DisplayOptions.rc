#include <windows.h>
#include "resource.h"

IDD_DISPLAY DIALOGEX 0, 0, 280, 154
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IPv4/IPv6 Traffic - Display"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Single line", -1, 10, 12, 66, 12
    EDITTEXT IDC_SINGLE, 78, 10, 192, 14, ES_AUTOHSCROLL
    LTEXT "First row", -1, 10, 34, 66, 12
    EDITTEXT IDC_FIRST, 78, 32, 192, 14, ES_AUTOHSCROLL
    LTEXT "Second row", -1, 10, 56, 66, 12
    EDITTEXT IDC_SECOND, 78, 54, 192, 14, ES_AUTOHSCROLL
    LTEXT "{v4}: IPv4 total     {v6}: IPv6 total", -1, 78, 75, 192, 12
    LTEXT "G decimal places", -1, 10, 98, 88, 12
    EDITTEXT IDC_DECIMALS, 102, 96, 24, 14, ES_NUMBER
    PUSHBUTTON "Defaults", IDC_DEFAULTS, 10, 130, 55, 14
    DEFPUSHBUTTON "OK", IDOK, 154, 130, 55, 14
    PUSHBUTTON "Cancel", IDCANCEL, 215, 130, 55, 14
END
